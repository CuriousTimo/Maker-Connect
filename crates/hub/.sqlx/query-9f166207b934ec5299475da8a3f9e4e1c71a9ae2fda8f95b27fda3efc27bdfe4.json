  "query": "SELECT s.id, unix_seconds(s.last_seen) AS \"last_seen!\", u.id AS user_id, u.name, u.display_name, u.instance_admin, s.space_id\n             FROM sessions s JOIN users u ON u.id = s.user_id\n             WHERE s.token_hash = $1 AND s.expires_at > at_unix($2) AND NOT u.disabled",
