{
  "db_name": "PostgreSQL",
  "query": "SELECT t.id, t.space_id, t.role, t.name, t.created_by, unix_seconds(t.last_used) AS \"last_used?\"\n             FROM api_tokens t\n             JOIN users u ON u.id = t.created_by AND NOT u.disabled\n             WHERE t.token_hash = $1 AND NOT t.revoked",
