  "query": "SELECT r.id, r.user_id, u.display_name, r.machine_id, unix_seconds(r.asked_at) AS \"asked_at!\"\n               FROM access_requests r JOIN users u ON u.id = r.user_id\n               WHERE r.space_id = $1 AND r.state = 'open' ORDER BY r.asked_at, r.id",
