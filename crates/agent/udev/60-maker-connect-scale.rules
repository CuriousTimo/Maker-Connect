# Maker Connect agent: a DYMO M-series scale on Linux (docs/archive/plans/agent-engine.md, Step 3e, E10).
# The kernel makes the scale a hidraw device that only root may read; this lets the group plugdev read it.
# Install (not done by the agent):
#   sudo cp 60-maker-connect-scale.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
#   and the agent's user must be in the group plugdev (sudo usermod -aG plugdev <user>, then log in again).
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0922", MODE="0660", GROUP="plugdev"
