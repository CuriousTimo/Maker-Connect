{
 "virtual_printer": {
  "enabled": true,
  "sendWait": false,
  "capabilities": {
   "AUTOREPORT_TEMP": false,
   "AUTOREPORT_SD_STATUS": false
  }
 },
 "octoprint": {
  "serial": {
   "timeout": {
    "temperature": 3600.0,
    "temperatureTargetSet": 3600.0,
    "sdStatus": 3600.0
   }
  }
 },
 "why": {
  "virtual_printer.enabled": "the plugin only answers the port VIRTUAL when it is enabled",
  "virtual_printer.sendWait": "no `wait` lines every waitInterval seconds: they come from the wall clock",
  "virtual_printer.capabilities.AUTOREPORT_TEMP": "no timed temperature reports from the printer: they come from the wall clock (and comm would send M155)",
  "virtual_printer.capabilities.AUTOREPORT_SD_STATUS": "no timed SD status reports (and comm would send M27 S)",
  "octoprint.serial.timeout.temperature": "comm's own temperature poll (default 5 s): it lands in a run at a moment that depends on how long the run took, so it is put off the clock; it also makes the read timeout 3601 s, so no timeout happens",
  "octoprint.serial.timeout.temperatureTargetSet": "as above, the poll while a target is set (default 2 s)",
  "octoprint.serial.timeout.sdStatus": "as above, the SD status poll while printing from the card (default 1 s)"
 },
